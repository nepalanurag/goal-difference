# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Phase 9.5: local working files DVC must not try to hash or cache.
# The versioned Parquet lake and raw API dumps are regenerated by extract
# and identified by data/MANIFEST.json content hashes instead.
data/lake/
data/raw/
data/*.parquet
